            "enabled": true,
            "pre_charge": true,
            "optimal_force_timing": true,
            "charge_time_factor": 1.2,
            "optimal_force_position": 0.3,
            "turn_off_position": 0.8,
            "gradual_turn_on": false,
            "turn_on_duration": 5e-05,
            "inter_stage_timing": {
                "stage_2_delay": 0.008,
